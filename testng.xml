<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Maiukha Full Test Suite" verbose="1">
  <parameter name="browser" value="chromium"/>

  <listeners>
    <listener class-name="com.aiden.maiukha.listeners.TestListener"/>
  </listeners>

  <test name="1 - Smoke Testing">
    <classes><class name="com.aiden.maiukha.tests.SmokeTests"/></classes>
  </test>
  <test name="2 - Sign In (Functional, Negative, Boundary)">
    <classes><class name="com.aiden.maiukha.tests.LoginTests"/></classes>
  </test>
  <test name="3 - Sign Up (Functional, Negative, Boundary, E2E)">
    <classes><class name="com.aiden.maiukha.tests.SignUpTests"/></classes>
  </test>
  <test name="4 - Security Testing">
    <classes><class name="com.aiden.maiukha.tests.SecurityTests"/></classes>
  </test>
  <test name="5 - Performance Testing">
    <classes><class name="com.aiden.maiukha.tests.PerformanceTests"/></classes>
  </test>
  <test name="6 - Accessibility Testing">
    <classes><class name="com.aiden.maiukha.tests.AccessibilityTests"/></classes>
  </test>
  <test name="7 - UI / Usability / Visual Testing">
    <classes><class name="com.aiden.maiukha.tests.UiTests"/></classes>
  </test>
  <test name="8 - Responsive Testing">
    <classes><class name="com.aiden.maiukha.tests.ResponsiveTests"/></classes>
  </test>
  <test name="9 - Error Handling / Reliability">
    <classes><class name="com.aiden.maiukha.tests.ErrorHandlingTests"/></classes>
  </test>
  <test name="10 - Cross-Browser Compatibility">
    <classes><class name="com.aiden.maiukha.tests.CrossBrowserTests"/></classes>
  </test>
</suite>